{
  "name": "study-shelf",
  "version": "1.0.0",
  "private": true,
  "description": "NCERT chapters for Class 9 and 10, rebuilt as interactive missions. Offline-first.",
  "scripts": {
    "fonts": "bash scripts/fetch-fonts.sh",
    "add:android": "cap add android",
    "sync": "cap sync android",
    "open:android": "cap open android",
    "run:android": "cap run android",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew bundleRelease",
    "serve": "npx --yes http-server www -p 5173 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
